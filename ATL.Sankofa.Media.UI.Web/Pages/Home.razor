@page "/"
@inject IVideoService VideoService
@inject ILiveStreamService LiveStreamService
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>ATL Sankofa Media</PageTitle>

@* ─── HERO FEATURED ─── *@
@if (FeaturedVideos?.Count > 0)
{
    var featured = FeaturedVideos[0];
    <section class="hero-banner" @onclick="() => NavigateToVideo(featured)">
        <img class="hero-img" src="@(featured.ThumbnailUrl ?? "images/placeholder.jpg")" alt="@featured.Title" />
        <div class="hero-gradient"></div>
        <div class="hero-content">
            <span class="hero-badge">
                <MudIcon Icon="@Icons.Material.Filled.Whatshot" Size="Size.Small" />
                Featured Today
            </span>
            <h1 class="hero-title">@featured.Title</h1>
            <p class="hero-description">@featured.Description</p>
            <div class="hero-actions">
                <button class="btn-primary" @onclick="() => NavigateToVideo(featured)" @onclick:stopPropagation="true">
                    <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" />
                    Play Now
                </button>
                <button class="btn-secondary">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                    My List
                </button>
            </div>
        </div>
    </section>
}
else
{
    <div class="hero-skeleton"></div>
}

@* ─── CATEGORY FILTER ─── *@
<div class="category-pills">
    <button class="pill @(_selectedCategory == null ? "active" : "")" @onclick="() => OnCategoryChanged(null)">All</button>
    <button class="pill @(_selectedCategory == "Gaming" ? "active" : "")" @onclick='() => OnCategoryChanged("Gaming")'>Gaming</button>
    <button class="pill @(_selectedCategory == "Music" ? "active" : "")" @onclick='() => OnCategoryChanged("Music")'>Music</button>
    <button class="pill @(_selectedCategory == "Travel" ? "active" : "")" @onclick='() => OnCategoryChanged("Travel")'>Travel</button>
    <button class="pill @(_selectedCategory == "Cooking" ? "active" : "")" @onclick='() => OnCategoryChanged("Cooking")'>Cooking</button>
    <button class="pill @(_selectedCategory == "Nature" ? "active" : "")" @onclick='() => OnCategoryChanged("Nature")'>Nature</button>
    <button class="pill @(_selectedCategory == "Space" ? "active" : "")" @onclick='() => OnCategoryChanged("Space")'>Space</button>
</div>

@* ─── RECOMMENDED / TRENDING ─── *@
<section class="video-section">
    <div class="section-header">
        <h2 class="section-title">Recommended for you</h2>
        <button class="see-all-btn">See all <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" /></button>
    </div>
    <div class="video-grid">
        @foreach (var video in _videos)
        {
            <div class="video-card" @onclick="() => NavigateToVideo(video)">
                <div class="card-thumb">
                    <img src="@(video.ThumbnailUrl ?? "images/placeholder.jpg")" alt="@video.Title" />
                    @if (video.Duration.HasValue)
                    {
                        <span class="duration-tag">@FormatDuration(video.Duration.Value)</span>
                    }
                    <button class="fav-btn">
                        <MudIcon Icon="@Icons.Material.Filled.FavoriteBorder" Size="Size.Small" />
                    </button>
                </div>
                <div class="card-info">
                    <div class="channel-avatar">@ChannelInitials(video.ChannelName)</div>
                    <div class="card-meta">
                        <h3 class="card-title">@video.Title</h3>
                        <span class="card-channel">@video.ChannelName</span>
                        <span class="card-stats">@FormatViewCount(video.ViewCount) views · @FormatTimeAgo(video.PublishedAt)</span>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@* ─── CONTINUE WATCHING / MOST RECENT ─── *@
@if (_recentVideos.Count > 0)
{
    <section class="video-section">
        <div class="section-header">
            <h2 class="section-title">Continue watching</h2>
            <button class="see-all-btn">See all <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" /></button>
        </div>
        <div class="video-grid">
            @foreach (var video in _recentVideos.Take(6))
            {
                <div class="video-card" @onclick="() => NavigateToVideo(video)">
                    <div class="card-thumb">
                        <img src="@(video.ThumbnailUrl ?? "images/placeholder.jpg")" alt="@video.Title" />
                        @if (video.Duration.HasValue)
                        {
                            <span class="duration-tag">@FormatDuration(video.Duration.Value)</span>
                        }
                        <button class="fav-btn">
                            <MudIcon Icon="@Icons.Material.Filled.FavoriteBorder" Size="Size.Small" />
                        </button>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: 66%;"></div>
                        </div>
                    </div>
                    <div class="card-info">
                        <div class="channel-avatar">@ChannelInitials(video.ChannelName)</div>
                        <div class="card-meta">
                            <h3 class="card-title">@video.Title</h3>
                            <span class="card-channel">@video.ChannelName</span>
                            <span class="card-stats">@FormatTimeAgo(video.PublishedAt)</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

@* ─── INFINITE SCROLL SENTINEL ─── *@
@if (_isLoading)
{
    <div class="loading-spinner">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
    </div>
}
<div class="scroll-sentinel" @ref="_scrollSentinel"></div>

@code {
    private List<VideoDto> FeaturedVideos = new();
    private List<VideoDto> _videos = new();
    private List<VideoDto> _recentVideos = new();
    private LiveStreamListResponse? ActiveStreams;

    private string? _selectedCategory;
    private int _currentPage = 1;
    private int _pageSize = 9;
    private int _totalCount;
    private bool _isLoading;
    private bool _allLoaded;
    private string? _errorMessage;

    private ElementReference _scrollSentinel;
    private DotNetObjectReference<Home>? _selfRef;
    private IJSObjectReference? _observerModule;

    protected override async Task OnInitializedAsync()
    {
        await LoadVideosAsync();
        await LoadRecentVideosAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            try
            {
                _observerModule = await JSRuntime.InvokeAsync<IJSObjectReference>("eval", @"
                    (function() {
                        let m = {};
                        m.observe = function(el, dotnetRef) {
                            if (!el) return;
                            const obs = new IntersectionObserver(entries => {
                                if (entries[0].isIntersecting) {
                                    dotnetRef.invokeMethodAsync('LoadMoreVideos');
                                }
                            }, { rootMargin: '200px' });
                            obs.observe(el);
                            m.disconnect = () => obs.disconnect();
                        };
                        return m;
                    })()
                ");
                await _observerModule.InvokeVoidAsync("observe", _scrollSentinel, _selfRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task LoadMoreVideos()
    {
        if (_isLoading || _allLoaded) return;
        _currentPage++;
        await LoadVideosAsync(append: true);
        StateHasChanged();
    }

    private async Task LoadVideosAsync(bool append = false)
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var result = await VideoService.GetPublicFeedAsync(_currentPage, _pageSize, _selectedCategory);
            _totalCount = result.TotalCount;

            if (append)
                _videos.AddRange(result.Videos);
            else
                _videos = result.Videos.ToList();

            if (!append && _videos.Count > 0)
                FeaturedVideos = _videos.Take(1).ToList();

            _allLoaded = _videos.Count >= _totalCount;
        }
        catch (Exception ex)
        {
            _errorMessage = "Unable to load videos. Please try again later.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadRecentVideosAsync()
    {
        try
        {
            var result = await VideoService.GetPublicFeedAsync(1, 6);
            _recentVideos = result.Videos.OrderByDescending(v => v.PublishedAt).Take(6).ToList();
        }
        catch { }
    }

    private async Task OnCategoryChanged(string? category)
    {
        _selectedCategory = category;
        _currentPage = 1;
        _allLoaded = false;
        await LoadVideosAsync();
    }

    private void NavigateToVideo(VideoDto video)
    {
        Navigation.NavigateTo($"/watch/{video.Id}");
    }

    private void NavigateToStream(LiveStreamDto stream)
    {
        Navigation.NavigateTo($"/live/{stream.Id}");
    }

    private static string FormatViewCount(long views) => views switch
    {
        >= 1_000_000 => $"{views / 1_000_000.0:0.#}M",
        >= 1_000 => $"{views / 1_000.0:0.#}K",
        _ => views.ToString()
    };

    private static string FormatTimeAgo(DateTime? date)
    {
        if (date == null) return "";
        var diff = DateTime.UtcNow - date.Value;
        return diff.TotalDays switch
        {
            >= 365 => $"{(int)(diff.TotalDays / 365)} year(s) ago",
            >= 30 => $"{(int)(diff.TotalDays / 30)} month(s) ago",
            >= 7 => $"{(int)(diff.TotalDays / 7)} week(s) ago",
            >= 1 => $"{(int)diff.TotalDays} day(s) ago",
            _ when diff.TotalHours >= 1 => $"{(int)diff.TotalHours} hour(s) ago",
            _ => "Just now"
        };
    }

    private static string FormatDuration(TimeSpan d) =>
        d.TotalHours >= 1 ? d.ToString(@"h\:mm\:ss") : d.ToString(@"m\:ss");

    private static string ChannelInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : name[..Math.Min(2, name.Length)].ToUpper();
    }

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_observerModule != null)
            {
                await _observerModule.InvokeVoidAsync("disconnect");
                await _observerModule.DisposeAsync();
            }
        }
        catch { }
        _selfRef?.Dispose();
    }
}
