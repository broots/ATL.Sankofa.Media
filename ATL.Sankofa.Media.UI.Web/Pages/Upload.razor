@page "/upload"
@inject IVideoService VideoService
@inject IChannelService ChannelService

<PageTitle>Upload Video - ATL Sankofa Media</PageTitle>

<div class="upload-page">
    <h1>Upload Video</h1>

    <div class="upload-form">
        <div class="form-group">
            <label>Title</label>
            <input type="text" @bind="UploadRequest.Title" placeholder="Enter video title" />
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea @bind="UploadRequest.Description" placeholder="Describe your video" rows="4"></textarea>
        </div>

        <div class="form-group">
            <label>Category</label>
            <select @bind="UploadRequest.Category">
                <option value="">Select category</option>
                <option value="Entertainment">Entertainment</option>
                <option value="Education">Education</option>
                <option value="Music">Music</option>
                <option value="Sports">Sports</option>
                <option value="News">News</option>
                <option value="Technology">Technology</option>
                <option value="Gaming">Gaming</option>
            </select>
        </div>

        <div class="form-group">
            <label>Tags (comma-separated)</label>
            <input type="text" @bind="UploadRequest.Tags" placeholder="tag1, tag2, tag3" />
        </div>

        <div class="form-group">
            <label>Visibility</label>
            <select @bind="UploadRequest.Visibility">
                <option value="@VideoVisibility.Private">Private</option>
                <option value="@VideoVisibility.Unlisted">Unlisted</option>
                <option value="@VideoVisibility.Public">Public</option>
            </select>
        </div>

        <div class="form-group">
            <label>Access Tier</label>
            <select @bind="UploadRequest.RequiredAccessTier">
                <option value="@AccessTier.Free">Free</option>
                <option value="@AccessTier.Basic">Basic Subscribers</option>
                <option value="@AccessTier.Premium">Premium Subscribers</option>
                <option value="@AccessTier.PayPerView">Pay-Per-View</option>
            </select>
        </div>

        @if (UploadRequest.RequiredAccessTier == AccessTier.PayPerView)
        {
            <div class="form-group">
                <label>Purchase Price ($)</label>
                <input type="number" step="0.01" @bind="UploadRequest.PurchasePrice" />
            </div>
        }

        <button class="btn-upload" @onclick="InitiateUpload" disabled="@IsUploading">
            @(IsUploading ? "Preparing upload..." : "Upload Video")
        </button>

        @if (!string.IsNullOrEmpty(UploadUrl))
        {
            <div class="upload-ready">
                <p>✓ Upload URL ready. Use this URL to upload your video file:</p>
                <code>@UploadUrl</code>
            </div>
        }

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="error-message">@ErrorMessage</div>
        }
    </div>
</div>

@code {
    private VideoUploadRequest UploadRequest = new();
    private string? UploadUrl;
    private string? ErrorMessage;
    private bool IsUploading;

    // Placeholder - in production from auth
    private Guid CurrentChannelId = Guid.Empty;

    private async Task InitiateUpload()
    {
        if (string.IsNullOrWhiteSpace(UploadRequest.Title))
        {
            ErrorMessage = "Please enter a video title.";
            return;
        }

        IsUploading = true;
        ErrorMessage = null;

        try
        {
            UploadRequest.ChannelId = CurrentChannelId;
            var response = await VideoService.InitiateUploadAsync(UploadRequest);
            UploadUrl = response.UploadUrl;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Upload failed: {ex.Message}";
        }
        finally
        {
            IsUploading = false;
        }
    }
}
