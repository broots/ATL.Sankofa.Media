@using ATL.Sankofa.Media.Business.Models
@using ATL.Sankofa.Media.UI.Shared.Auth
@using System.Net.Http.Json
@inject HttpClient Http
@inject TokenAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="login-form">
    <h2>Sign In</h2>

    @if (Errors.Any())
    {
        <div class="error-messages">
            @foreach (var error in Errors)
            {
                <p class="error">@error</p>
            }
        </div>
    }

    <div class="form-group">
        <label>Email</label>
        <input type="email" @bind="LoginModel.Email" placeholder="your@email.com" />
    </div>

    <div class="form-group">
        <label>Password</label>
        <input type="password" @bind="LoginModel.Password" placeholder="Password" />
    </div>

    <button class="btn-primary" @onclick="HandleLogin" disabled="@IsLoading">
        @(IsLoading ? "Signing in..." : "Sign In")
    </button>

    <div class="divider"><span>or continue with</span></div>

    <div class="external-providers">
        <button class="btn-external btn-google" @onclick='() => HandleExternalLogin("Google")'>
            Google
        </button>
        <button class="btn-external btn-facebook" @onclick='() => HandleExternalLogin("Facebook")'>
            Facebook
        </button>
        <button class="btn-external btn-twitter" @onclick='() => HandleExternalLogin("Twitter")'>
            Twitter
        </button>
    </div>

    <p class="form-footer">
        Don't have an account? <a href="/register">Sign Up</a>
    </p>
</div>

@code {
    [Parameter] public string ReturnUrl { get; set; } = "/";
    [Parameter] public EventCallback<AuthResponse> OnLoginSuccess { get; set; }

    private LoginRequest LoginModel = new();
    private List<string> Errors = new();
    private bool IsLoading;

    private async Task HandleLogin()
    {
        Errors.Clear();
        IsLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", LoginModel);
            var result = await response.Content.ReadFromJsonAsync<AuthResponse>();

            if (result?.Succeeded == true)
            {
                await AuthStateProvider.LoginAsync(result);
                await OnLoginSuccess.InvokeAsync(result);
                Navigation.NavigateTo(ReturnUrl);
            }
            else
            {
                Errors = result?.Errors ?? new List<string> { "Login failed." };
            }
        }
        catch (Exception ex)
        {
            Errors.Add($"An error occurred: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void HandleExternalLogin(string provider)
    {
        Navigation.NavigateTo($"api/auth/external-login/{provider}?returnUrl={Uri.EscapeDataString(ReturnUrl)}", forceLoad: true);
    }
}
