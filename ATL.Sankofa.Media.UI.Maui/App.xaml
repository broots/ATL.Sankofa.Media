<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:ATL.Sankofa.Media.UI.Maui.Converters"
             x:Class="ATL.Sankofa.Media.UI.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Converters -->
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
            <converters:ViewCountConverter x:Key="ViewCountConverter" />
            <converters:TimeAgoConverter x:Key="TimeAgoConverter" />
            <converters:DurationConverter x:Key="DurationConverter" />
            <converters:InitialsConverter x:Key="InitialsConverter" />

            <!-- Colors -->
            <Color x:Key="BackgroundDark">#0a0a0a</Color>
            <Color x:Key="SurfaceDark">#171717</Color>
            <Color x:Key="TextPrimary">#fafafa</Color>
            <Color x:Key="TextSecondary">#a1a1a1</Color>
            <Color x:Key="AccentPurple">#ad46ff</Color>
            <Color x:Key="AccentGreen">#00bc7d</Color>

            <!-- Styles -->
            <Style TargetType="Page" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource BackgroundDark}" />
            </Style>
            <Style TargetType="Shell" ApplyToDerivedTypes="True">
                <Setter Property="Shell.BackgroundColor" Value="{StaticResource BackgroundDark}" />
                <Setter Property="Shell.ForegroundColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource BackgroundDark}" />
                <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TextSecondary}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
