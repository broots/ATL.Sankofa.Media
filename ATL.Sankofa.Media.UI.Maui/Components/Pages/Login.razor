@page "/login"
@inject HttpClient Http
@inject TokenAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<h2>Sign In</h2>

@if (Errors.Any())
{
    <div class="error-messages">
        @foreach (var error in Errors)
        {
            <p>@error</p>
        }
    </div>
}

<div class="form-group">
    <label>Email</label>
    <input type="email" @bind="LoginModel.Email" placeholder="your@email.com" />
</div>

<div class="form-group">
    <label>Password</label>
    <input type="password" @bind="LoginModel.Password" placeholder="Password" />
</div>

<button class="btn-primary" @onclick="HandleLogin" disabled="@IsLoading">
    @(IsLoading ? "Signing in..." : "Sign In")
</button>

<div class="external-providers">
    <p>Or sign in with:</p>
    <button class="btn-external" @onclick='() => HandleExternalLogin("Google")'>Google</button>
    <button class="btn-external" @onclick='() => HandleExternalLogin("Facebook")'>Facebook</button>
    <button class="btn-external" @onclick='() => HandleExternalLogin("Twitter")'>Twitter</button>
</div>

@code {
    private LoginRequest LoginModel = new();
    private List<string> Errors = new();
    private bool IsLoading;

    private async Task HandleLogin()
    {
        Errors.Clear();
        IsLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", LoginModel);
            var result = await response.Content.ReadFromJsonAsync<AuthResponse>();

            if (result?.Succeeded == true)
            {
                await AuthStateProvider.LoginAsync(result);
                Navigation.NavigateTo("/");
            }
            else
            {
                Errors = result?.Errors ?? new List<string> { "Login failed." };
            }
        }
        catch (Exception ex)
        {
            Errors.Add($"Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleExternalLogin(string provider)
    {
        try
        {
            // Use MAUI WebAuthenticator for external OAuth
            var authUrl = new Uri($"{Http.BaseAddress}api/auth/external-login/{provider}?returnUrl=/auth-callback");
            var callbackUrl = new Uri("atlsankofamedia://auth-callback");

            var result = await WebAuthenticator.Default.AuthenticateAsync(authUrl, callbackUrl);

            var token = result.Properties.ContainsKey("token") ? result.Properties["token"] : null;
            var refreshToken = result.Properties.ContainsKey("refreshToken") ? result.Properties["refreshToken"] : null;

            if (!string.IsNullOrEmpty(token) && !string.IsNullOrEmpty(refreshToken))
            {
                var authResponse = new AuthResponse
                {
                    Succeeded = true,
                    Token = token,
                    RefreshToken = refreshToken
                };
                await AuthStateProvider.LoginAsync(authResponse);
                Navigation.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            Errors.Add($"External login failed: {ex.Message}");
        }
    }
}
