@page "/watch/{VideoId:guid}"
@inject IVideoService VideoService
@inject IPaywallService PaywallService

<div class="watch-container">
    @if (Video != null)
    {
        <VideoPlayer PlaybackUrl="@PlaybackUrl"
                     ShowPaywall="@ShowPaywall"
                     PaywallMessage="@PaywallMessage"
                     PurchasePrice="@Video.PurchasePrice"
                     OnPurchase="HandlePurchase"
                     OnSubscribe="HandleSubscribe" />

        <h2>@Video.Title</h2>
        <p>@Video.ChannelName &bull; @Video.ViewCount.ToString("N0") views</p>
        @if (!string.IsNullOrEmpty(Video.Description))
        {
            <p>@Video.Description</p>
        }
    }
    else
    {
        <p>Loading...</p>
    }
</div>

@code {
    [Parameter] public Guid VideoId { get; set; }

    private VideoDto? Video;
    private string? PlaybackUrl;
    private bool ShowPaywall;
    private string PaywallMessage = string.Empty;
    private Guid CurrentUserId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        Video = await VideoService.GetVideoAsync(VideoId);
        if (Video != null)
        {
            await VideoService.IncrementViewCountAsync(VideoId);

            if (Video.RequiredAccessTier == AccessTier.Free)
            {
                PlaybackUrl = Video.HlsPlaybackUrl;
            }
            else if (CurrentUserId != Guid.Empty)
            {
                var access = await PaywallService.CheckVideoAccessAsync(CurrentUserId, VideoId);
                if (access.HasAccess)
                {
                    PlaybackUrl = await VideoService.GetPlaybackUrlAsync(VideoId, CurrentUserId);
                }
                else
                {
                    ShowPaywall = true;
                    PaywallMessage = access.DenialReason ?? "Access denied.";
                }
            }
            else
            {
                ShowPaywall = true;
                PaywallMessage = "Please sign in to watch this content.";
            }
        }
    }

    private void HandlePurchase() { }
    private void HandleSubscribe() { }
}
