@page "/"
@inject IVideoService VideoService
@inject ILiveStreamService LiveStreamService

<h2>🔴 Live Now</h2>
<div class="stream-grid">
    @if (ActiveStreams?.LiveStreams?.Count > 0)
    {
        @foreach (var stream in ActiveStreams.LiveStreams)
        {
            <LiveStreamCard Stream="stream" OnStreamSelected="NavigateToStream" />
        }
    }
    else
    {
        <p>No live streams at the moment</p>
    }
</div>

<h2>Trending Videos</h2>
<div class="video-grid">
    @if (TrendingVideos?.Videos?.Count > 0)
    {
        @foreach (var video in TrendingVideos.Videos)
        {
            <VideoCard Video="video" OnVideoSelected="NavigateToVideo" />
        }
    }
    else
    {
        <p>No videos available</p>
    }
</div>

@code {
    private VideoListResponse? TrendingVideos;
    private LiveStreamListResponse? ActiveStreams;

    protected override async Task OnInitializedAsync()
    {
        TrendingVideos = await VideoService.GetPublicFeedAsync(page: 1, pageSize: 10);
        ActiveStreams = await LiveStreamService.GetActiveLiveStreamsAsync(page: 1, pageSize: 4);
    }

    private void NavigateToVideo(VideoDto video) { }
    private void NavigateToStream(LiveStreamDto stream) { }
}
