<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:ATL.Sankofa.Media.UI.Maui.Views"
       x:Class="ATL.Sankofa.Media.UI.Maui.AppShell"
       Shell.BackgroundColor="#0a0a0a"
       Shell.ForegroundColor="#fafafa"
       Shell.TitleColor="#fafafa"
       Shell.UnselectedColor="#a1a1a1"
       Shell.TabBarBackgroundColor="#0a0a0a"
       Shell.TabBarForegroundColor="#fafafa"
       Shell.TabBarUnselectedColor="#a1a1a1">

    <TabBar>
        <ShellContent Title="Home"
                      Icon="{OnPlatform Android='home', iOS='home'}"
                      ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Title="Trending"
                      Icon="{OnPlatform Android='trending_up', iOS='trending_up'}"
                      ContentTemplate="{DataTemplate views:TrendingPage}" />
        <ShellContent Title="Subscriptions"
                      Icon="{OnPlatform Android='subscriptions', iOS='subscriptions'}"
                      ContentTemplate="{DataTemplate views:SubscriptionsPage}" />
        <ShellContent Title="Library"
                      Icon="{OnPlatform Android='video_library', iOS='video_library'}"
                      ContentTemplate="{DataTemplate views:LibraryPage}" />
    </TabBar>

</Shell>
